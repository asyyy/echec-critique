{
  "name": "echec-critique",
  "version": "0.4.0",
  "private": true,
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:share": "VITE_BASE=/ npm run build-only",
    "android:sync": "npm run build:share && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && JAVA_HOME=\"${JAVA_HOME_21:-$HOME/Library/Java/JavaVirtualMachines/openjdk-21.0.1/Contents/Home}\" ./gradlew assembleDebug && cd .. && mkdir -p apk && cp -f android/app/build/outputs/apk/debug/app-debug.apk apk/echec-critique-debug.apk && echo \"\\nAPK: apk/echec-critique-debug.apk\"",
    "android:zip": "npm run android:apk && cd apk && rm -f echec-critique-debug.apk.zip && zip -q echec-critique-debug.apk.zip echec-critique-debug.apk && cd .. && echo \"\\nZIP: apk/echec-critique-debug.apk.zip\"",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.0.0",
    "sharp": "^0.35.4",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^2.0.0",
    "workbox-window": "^7.0.0"
  }
}
